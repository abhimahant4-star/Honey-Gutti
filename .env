# Change this to your real Vercel address after the first deploy, then Redeploy.
NEXT_PUBLIC_SITE_URL=https://doy-joy-store.vercel.app

# DUMMY. Replace with your real MongoDB Atlas string (the one in your .env.local).
MONGODB_URI=mongodb+srv://dummyuser:dummypass@dummy-cluster.mongodb.net/doyjoy?retryWrites=true&w=majority

# DUMMY PayU values. Payments will NOT work until you add the real TEST key and salt.
PAYU_MERCHANT_KEY=DUMMYKEY123
PAYU_MERCHANT_SALT=DUMMYSALT123
PAYU_BASE_URL=https://test.payu.in/_payment

# Login for /admin/orders (random password made for you; change it if you like)
ADMIN_USER=admin
ADMIN_PASSWORD=PZDORzmVMdKlDXW3

NEXT_PUBLIC_SUPPORT_EMAIL=care@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+91 99999 99999