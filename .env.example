# Public URL of the site (used for SEO and for PayU to send customers back)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string (database name goes before the ?)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/doyjoy?retryWrites=true&w=majority

# PayU (Dashboard > switch to Test Mode > Key and Salt). Use test credentials first.
PAYU_MERCHANT_KEY=your_merchant_key
PAYU_MERCHANT_SALT=your_merchant_salt
# Test:       https://test.payu.in/_payment
# Production: https://secure.payu.in/_payment
PAYU_BASE_URL=https://test.payu.in/_payment

# Login sessions: a long random secret (at least 32 characters). Keep it private.
# Changing it logs everyone out.
AUTH_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# Admin login at /admin/login (password: at least 10 characters)
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password

NEXT_PUBLIC_SUPPORT_EMAIL=care@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+91 99999 99999

# Email for "Forgot password" (any SMTP account). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your Gmail address, SMTP_PASS=a 16-letter Google "App password" (not your normal password).
# Leave empty while testing locally: the reset link is printed in the npm run dev terminal instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Doy & Joy <care@example.com>"
